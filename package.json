{
  "name": "open-autofill",
  "version": "1.0.0",
  "description": "Firefox extension for automatic form filling with Google Sheets sync",
  "scripts": {
    "build:css": "tailwindcss -i ./src/ui/styles/input.css -o ./src/ui/styles/output.css --minify",
    "watch:css": "tailwindcss -i ./src/ui/styles/input.css -o ./src/ui/styles/output.css --watch",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}
